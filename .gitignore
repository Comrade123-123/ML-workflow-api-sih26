# Environment / secrets
.env
.env.*
# .env.example is a secret-free template meant to be committed and shared.
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode/cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
tmp/
temp/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local Claude Code session/tooling state -- machine/session-specific, not source
.claude/

# Trained model artifacts are regenerated by scripts/train_module*.py from
# Data/ -- do not commit them by default. Keep the directory structure via .gitkeep.
models/**/*.joblib
!models/**/.gitkeep

# EXCEPTION: the underspend-risk artifact is the approved, handed-off
# production deliverable (see docs/UNDESPEND_RISK_BACKEND_HANDOFF.md) --
# unlike Module 1/2's regeneratable artifacts, this one is the actual
# distributed model file, so it is explicitly un-ignored here.
!models/underspend_risk/underspend_risk_model.joblib

# Module 7's pulse-score snapshot store is runtime state (per-environment),
# not source -- do not commit it.
state/**/*.json
!state/**/.gitkeep

# Abandoned Option 3 (MoSPI/IPMD infrastructure cost-overrun) raw source and
# derived research artifacts -- ~454MB of downloaded Flash Report PDFs, plus
# the datasets/splits/predictions/robustness-check files built from them.
# That experiment was abandoned (see OPTION2_MPLADS_TARGET_FEASIBILITY_REPORT.md);
# kept on local disk for reference but excluded from Git to avoid repo bloat.
# Not required to reproduce or understand the current (has_underspend) model.
#
# Each subdirectory is ignored individually (NOT the parent
# Data/module1_infra_source/ itself) so that MODULE1_OPTION3_FINAL_REPORT.md,
# which lives directly in that parent directory, remains trackable -- a
# negation pattern cannot re-include a file inside a directory that is
# itself excluded by a trailing-slash pattern, so ignoring the parent and
# trying to "!"-unignore the file would not have worked.
Data/module1_infra_source/raw_reports/
Data/module1_infra_source/datasets/
Data/module1_infra_source/model_dev/
